# TorBox API key from https://torbox.app/settings
TORBOX_API_KEY=

# Comet instance base URL (no trailing slash)
COMET_URL=https://comet.elfhosted.com

# Jellyfin library folders (paths inside the container — keep these on /raid/...)
MOVIES_PATH=/raid/Jellyfin/Movies
TV_SHOWS_PATH=/raid/Jellyfin/TV-Shows

# Website login password (required)
SITE_PASSWORD=changeme

# Optional: separate cookie signing secret (defaults to SITE_PASSWORD)
# AUTH_SECRET=

# Host path where your library is mounted (SMB/fstab). Bind-mounted into the container as /raid.
# If your share is on the host at /raid2, set LIBRARY_ROOT=/raid2 (app still uses /raid/... inside).
# LIBRARY_ROOT=/raid

# Host port to expose the web UI (default 3000)
# PORT=3000
