# TorBox API key from https://torbox.app/settings
TORBOX_API_KEY=

# Comet instance base URL (no trailing slash)
COMET_URL=https://comet.elfhosted.com

# Jellyfin library folders (separate roots)
MOVIES_PATH=/raid/Jellyfin/Movies
TV_SHOWS_PATH=/raid/Jellyfin/TV-Shows

# Legacy fallback: if MOVIES_PATH / TV_SHOWS_PATH unset, uses DOWNLOAD_PATH/Movies and DOWNLOAD_PATH/TV-Shows
# DOWNLOAD_PATH=/raid/Jellyfin

# Website login password (required)
SITE_PASSWORD=changeme

# Optional: separate cookie signing secret (defaults to SITE_PASSWORD)
# AUTH_SECRET=

# Optional: override settings file location
# SETTINGS_PATH=./data/settings.json
