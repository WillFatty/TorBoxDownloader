{
  "name": "torbox-downloader",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"PORT=${API_PORT:-3001} tsx watch src/server/index.ts\" \"vite --host\"",
    "build": "vite build && esbuild src/server/index.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist-server/index.js",
    "start": "node dist-server/index.js",
    "lint": "eslint ."
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@hono/node-server": "^2.1.1",
    "ffmpeg-static": "^5.3.0",
    "hono": "^4.13.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2"
  }
}
